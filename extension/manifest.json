{
  "manifest_version": 3,
  "name": "TodoX Sidebar",
  "version": "0.2.0",
  "description": "Collapse default sidebar modules on X.com and replace them with a lightweight TODO list.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "lib/verifyLicense.js",
        "lib/sponsors.js",
        "premium.js",
        "dist/panel.js",
        "minContentScript.js"
      ],
      "css": ["contentStyles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "completed.html",
        "dist/completed.js",
        "completed.css",
        "sponsors.json"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
