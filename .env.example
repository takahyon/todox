# Path to the Ed25519 private key used for signing TodoX+ licenses (never commit the actual file)
LICENSE_PRIVATE_KEY_PATH=./secrets/license_ed25519.key

# Base64-encoded Ed25519 public key for client-side verification
LICENSE_PUBLIC_KEY_BASE64=

# Location of the sponsor inventory JSON (can be remote URL or extension bundle path)
SPONSORS_URL=/sponsors.json

# Optional endpoint for redeeming unlock codes. When set, the client POSTs the
# entered code and expects a JSON response with { "licenseToken": "..." }.
LICENSE_REDEEM_URL=
